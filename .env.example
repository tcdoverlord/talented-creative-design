# Local development only. Never commit .env or real credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-characters
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://tcd_app:replace-with-a-long-random-database-password@localhost:5432/tcd_accounts
TRUST_PROXY=false

# Administrator access is granted only with the one-off CLI promotion script.

# Stripe: checkout remains disabled until configured. Use test-mode keys first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/account.html?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/shop.html?checkout=cancelled

# Email (optional in local dev; required before public launch for verification/password reset).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Talented Creative Design <no-reply@example.com>
APP_BASE_URL=http://localhost:3000

# Google OAuth (optional until configured in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private S3-compatible object storage for paid installers. Leave blank to disable downloads.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
